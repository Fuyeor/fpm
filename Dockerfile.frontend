# /Dockerfile.frontend
# Build the Vite frontend from published private registry packages.
FROM node:24-slim AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable

WORKDIR /app

# Copy workspace manifests first so dependency installation remains cacheable.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/registry/front-end/package.json ./apps/registry/front-end/

# Install published dependencies with a BuildKit-only registry credential.
RUN --mount=type=cache,id=fpm-pnpm-store,target=/pnpm/store \
    --mount=type=secret,id=fpm_registry_token,required \
    set -eu; \
    auth_file="$(mktemp)"; \
    trap 'rm -f "$auth_file"' EXIT; \
    printf '%s\n' \
        '@fuyeor:registry=https://fpm.fuyeor.com/v1/' \
        "//fpm.fuyeor.com/v1/:_authToken=$(cat /run/secrets/fpm_registry_token)" \
        > "$auth_file"; \
    pnpm install --frozen-lockfile --config.userconfig="$auth_file"

# Copy application sources only after dependencies are cached.
COPY apps/ ./apps/

# Build the production SPA from the fpm workspace root.
RUN pnpm --filter @fuyeor/fpm-front-end build

# Serve the static SPA with a small Nginx runtime image.
FROM nginx:alpine AS runner

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /app/apps/registry/front-end/dist/ /usr/share/nginx/html/

# Keep API requests on the same origin and support client-side routing.
RUN printf '%s\n' \
    'server {' \
    '    listen 80;' \
    '    server_name localhost;' \
    '    root /usr/share/nginx/html;' \
    '    include mime.types;' \
    '    index index.html;' \
    '    location / { try_files $uri $uri/ /index.html; }' \
    '}' \
    > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
