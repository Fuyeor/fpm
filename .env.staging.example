# /.env.staging.example
DATABASE_URL=postgres://USER:PASSWORD@POSTGRES_HOST:5432/fpm
JWT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ISSUER=fpm.fuyeor.com
JWT_AUDIENCE=fpm-frontend
IDP_BASE_URL=https://www.fuyeor.com
IDP_CLIENT_ID=REPLACE_WITH_IDP_CLIENT_ID
IDP_CLIENT_SECRET=REPLACE_WITH_IDP_CLIENT_SECRET
IDP_REDIRECT_URI=https://fpm.fuyeor.com/auth/callback
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=REPLACE_WITH_TEST_BUCKET_NAME
R2_PUBLIC_URL_BASE=https://test.fuyeor.net
